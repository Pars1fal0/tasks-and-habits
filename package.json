{
  "name": "rhythm-day",
  "version": "0.4.0",
  "private": true,
  "description": "Локальный десктопный трекер задач и привычек",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke-test",
    "test": "node tests/run-tests.cjs",
    "build:win": "electron-builder --win portable nsis",
    "pack:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.rhythm-day.tracker",
    "productName": "Ритм дня",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.js",
      "archive-view.js",
      "calendar-view.js",
      "categories.js",
      "CHANGELOG.md",
      "confirm-dialog.js",
      "desktop/**/*",
      "goals-view.js",
      "habit-form.js",
      "heatmap-view.js",
      "icon.svg",
      "index.html",
      "import-export.js",
      "manifest.webmanifest",
      "habits-view.js",
      "notifications.js",
      "quick-input.js",
      "recurrence.js",
      "README.md",
      "remote-sync.js",
      "settings-controller.js",
      "state-normalizer.js",
      "storage.js",
      "styles.css",
      "supabase-schema.sql",
      "task-form.js",
      "tasks-view.js",
      "task-moves.js",
      "timeline-controller.js",
      "timeline-view.js",
      "toast.js",
      "sw.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.0.12"
  }
}
