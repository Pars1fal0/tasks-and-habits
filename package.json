{
  "name": "rhythm-day",
  "version": "0.19.1",
  "private": true,
  "description": "Локальный десктопный трекер задач и привычек",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke-test",
    "test:e2e": "node tests/electron-e2e.cjs && node tests/menu-popovers-e2e.cjs && node tests/accessibility-e2e.cjs",
    "lint": "node tests/lint.cjs",
    "test": "node tests/run-tests.cjs",
    "test:sync-live": "node tests/remote-sync-live.cjs",
    "build:web": "node scripts/build-web.cjs",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler-build",
    "build:cloudflare": "npm test && npm run lint && npm run build:web && npm run build:worker",
    "mcp:dev": "npm run build:web && wrangler dev",
    "build:win": "electron-builder --win portable nsis",
    "pack:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.rhythm-day.tracker",
    "productName": "Ритм дня",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.js",
      "app-shell-controller.js",
      "app-utils.js",
      "archive-view.js",
      "app-events.js",
      "calendar-view.js",
      "calendar-drag-controller.js",
      "categories.js",
      "CHANGELOG.md",
      "confirm-dialog.js",
      "form-dialog.js",
      "date-rollover.js",
      "data-normalizers.js",
      "device-sync-controller.js",
      "disclosure-menus.css",
      "disclosure-menus.js",
      "desktop/**/*",
      "goal-checkpoint-editor.js",
      "global-search.js",
      "goals-view.js",
      "habit-form.js",
      "habit-config-history.js",
      "habit-title-history.js",
      "heatmap-view.js",
      "hosted-config.js",
      "icon.svg",
      "icon-192.png",
      "icon-512.png",
      "index.html",
      "import-export.js",
      "journal-model.js",
      "journal-view.js",
      "manifest.webmanifest",
      "habits-view.js",
      "mcp-activity.js",
      "mcp-activity-controller.js",
      "notifications.js",
      "navigation-state.js",
      "planning-history.js",
      "profile-settings.js",
      "pwa-controller.js",
      "overdue-controller.js",
      "quick-input.js",
      "recurrence.js",
      "remote-auth.js",
      "remote-auth-controller.js",
      "README.md",
      "remote-sync.js",
      "remote-sync-controller.js",
      "remote-data-controller.js",
      "sync-history.js",
      "sync-diagnostics.js",
      "settings-state.js",
      "settings-sync.js",
      "settings-transfer.js",
      "save-status.js",
      "shell-version.js",
      "settings-controller.js",
      "state-normalizer.js",
      "state-controller.js",
      "state-merge.js",
      "sync-metadata.js",
      "tombstone-retention.js",
      "storage.js",
      "styles.css",
      "supabase-schema.sql",
      "task-form.js",
      "task-schedule.js",
      "tasks-view.js",
      "task-moves.js",
      "task-state.js",
      "timeline-controller.js",
      "timeline-drag.js",
      "timeline-layout.js",
      "timeline-menu.js",
      "timeline-view.js",
      "toast.js",
      "view-renderer.js",
      "sw.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.110.7",
    "agents": "^0.17.4",
    "axe-core": "^4.12.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.61.1",
    "wrangler": "^4.114.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "brace-expansion": "5.0.8"
  }
}
