{
  "name": "rhythm-day",
  "version": "0.13.0",
  "private": true,
  "description": "Локальный десктопный трекер задач и привычек",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke-test",
    "test:e2e": "node tests/electron-e2e.cjs",
    "lint": "node tests/lint.cjs",
    "test": "node tests/run-tests.cjs",
    "build:web": "node scripts/build-web.cjs",
    "build:cloudflare": "npm test && npm run lint && npm run build:web",
    "build:win": "electron-builder --win portable nsis",
    "pack:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.rhythm-day.tracker",
    "productName": "Ритм дня",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.js",
      "app-utils.js",
      "archive-view.js",
      "app-events.js",
      "calendar-view.js",
      "calendar-drag-controller.js",
      "categories.js",
      "CHANGELOG.md",
      "confirm-dialog.js",
      "form-dialog.js",
      "date-rollover.js",
      "data-normalizers.js",
      "device-sync-controller.js",
      "desktop/**/*",
      "goal-checkpoint-editor.js",
      "goals-view.js",
      "habit-form.js",
      "habit-config-history.js",
      "habit-title-history.js",
      "heatmap-view.js",
      "icon.svg",
      "icon-192.png",
      "icon-512.png",
      "index.html",
      "import-export.js",
      "manifest.webmanifest",
      "habits-view.js",
      "notifications.js",
      "navigation-state.js",
      "planning-history.js",
      "pwa-controller.js",
      "overdue-controller.js",
      "quick-input.js",
      "recurrence.js",
      "remote-auth.js",
      "remote-auth-controller.js",
      "README.md",
      "remote-sync.js",
      "remote-sync-controller.js",
      "sync-history.js",
      "settings-state.js",
      "settings-sync.js",
      "settings-controller.js",
      "state-normalizer.js",
      "state-merge.js",
      "sync-metadata.js",
      "storage.js",
      "styles.css",
      "supabase-schema.sql",
      "task-form.js",
      "task-schedule.js",
      "tasks-view.js",
      "task-moves.js",
      "task-state.js",
      "timeline-controller.js",
      "timeline-drag.js",
      "timeline-layout.js",
      "timeline-menu.js",
      "timeline-view.js",
      "toast.js",
      "view-renderer.js",
      "sw.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.61.1",
    "wrangler": "^4.110.0"
  }
}
